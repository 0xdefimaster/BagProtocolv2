# Supabase project settings — Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# (No anon/publishable key: the app talks to Supabase only from the server,
# with the service-role key below. Every table has RLS on with no public
# policies, so a leaked anon key reads nothing.)

# Production-hardening P0-4 — isolates demo/mock data (lib/mock-data.ts)
# behind an explicit opt-in. Unset (or anything other than "true") means
# demo mode is OFF, which is what every real deployment should ship with —
# a real, wallet-connected user's Dashboard/Explore then show ONLY
# authoritative API/DB data, never fabricated numbers blended in. Set to
# "true" only for a deliberate demo/staging environment. See
# lib/config/demo-mode.ts.
NEXT_PUBLIC_DEMO_MODE=false

# Service-role key — server-only, NEVER expose to the client or prefix with
# NEXT_PUBLIC_. Used by API routes to write trades/points/leaderboard rows
# that a client must never be able to forge.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret (at least 32 characters, enforced) used to sign the
# wallet-login session cookie (JWT). Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Public origin of the site, e.g. https://bagprotocol.xyz. The wallet sign-in
# message names this domain; set it in production so the domain is never
# taken from a request header. Leave empty for local dev.
APP_ORIGIN=

# Required by app/api/cron/settle-creator-rewards and
# app/api/cron/reconcile-creator-rewards (lib/server/require-cron-secret.ts).
# Checked as "Authorization: Bearer <CRON_SECRET>" on every cron invocation.
# Fails closed (503) if unset — never leaves these routes open by accident.
# Generate one with: openssl rand -base64 32
CRON_SECRET=replace-with-a-long-random-string

# Accounting V2 wallet reconciliation — real-time trigger (optional; the
# 5-minute /api/cron/reconcile-wallets pass works without it). Signing key of
# an Alchemy ADDRESS_ACTIVITY webhook on Robinhood Chain whose URL is
# https://<your-site>/api/webhooks/alchemy/address-activity. The endpoint
# rejects every call while this is unset. Never commit the real key.
ALCHEMY_WEBHOOK_SIGNING_KEY=

# --- Blockchain RPC (lib/blockchain/rpc/, chains in lib/config/chains.ts) ---
# All server-side chain access (balances, eth_call, allowance, gas estimates,
# logs, receipts, oracle reads, the settlement worker's broadcasts) goes
# through ONE resilient layer, per chain, in this order:
#   1. primary   <CHAIN>_RPC_URL, else Alchemy built from ALCHEMY_API_KEY
#                (https://<eth|arb|base|robinhood>-mainnet.g.alchemy.com/v2/<key>)
#   2. secondary <CHAIN>_RPC_URL_SECONDARY (e.g. QuickNode)
#   3. public    the chain operator's public RPC (Arbitrum, Base, Robinhood;
#                Ethereum has none). Disable with RPC_PUBLIC_FALLBACK=false.
# Timeouts, bounded retries with backoff, a circuit breaker per endpoint and
# stale-node detection are built in. Signed transactions are never blindly
# re-broadcast: after an ambiguous failure the tx hash is looked up first.
# Server-only: the browser never sees these (it uses public RPCs).
# NEVER commit a real key.
ALCHEMY_API_KEY=
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
ETHEREUM_RPC_URL_SECONDARY=
ARBITRUM_RPC_URL_SECONDARY=
BASE_RPC_URL_SECONDARY=
ROBINHOOD_RPC_URL_SECONDARY=
RPC_PUBLIC_FALLBACK=true
# Legacy names RPC_URL_<CHAIN> (below) are still read as the primary URL.

# --- Bag deployment (user-signed — lib/blockchain/evm/, lib/server/deploy-bag.ts) ---
# See docs/USER_SIGNED_DEPLOYMENT.md for the full flow. An RPC (see above) and
# FACTORY_ADDRESS_<CHAIN> are REQUIRED per chain you want deployable: unlike
# the old backend-signed flow, there is NO mock fallback in any environment —
# an unconfigured or malformed chain fails closed (prepare/confirm both
# return CHAIN_UNAVAILABLE) rather than silently pretending to deploy.
#
# There is NO deployer/signing key here at all. `BagFactory.createBag()` is
# permissionless and user-signed — the Bag's creator's own connected wallet
# signs and sends it from the browser; the backend only ever READS the chain
# to verify what happened (lib/blockchain/evm/adapter.ts's
# `verifyBagCreation()`). `DEPLOYER_PRIVATE_KEY` below (scripts/ only) is a
# ONE-TIME key used solely to broadcast the BagFactory contract-creation
# transaction itself — never to call `createBag`, and never read by the
# running application.

FACTORY_ADDRESS_ETHEREUM=0xdeployed-bagfactory-address-on-ethereum
EXPLORER_URL_ETHEREUM=https://etherscan.io
# Optional. Block confirmations required before a deployment is accepted (default 1, max 64).
CONFIRMATIONS_ETHEREUM=1

FACTORY_ADDRESS_BASE=0xdeployed-bagfactory-address-on-base
EXPLORER_URL_BASE=https://basescan.org
CONFIRMATIONS_BASE=1

FACTORY_ADDRESS_ARBITRUM=0xdeployed-bagfactory-address-on-arbitrum
EXPLORER_URL_ARBITRUM=https://arbiscan.io
CONFIRMATIONS_ARBITRUM=1

# Optional. Max ms one confirm request waits for a receipt before answering 202 PENDING
# (default 20000, max 55000) — must fit inside your platform's function timeout; see
# app/api/bags/[id]/deploy/confirm/route.ts's `maxDuration`.
BAG_DEPLOYMENT_RECEIPT_TIMEOUT_MS=20000

# scripts/deploy-bag-factory.ts ONLY — never used by the running application (see above).
# A throwaway/funding-only key is fine; discard it from this env after the one-time deploy.
DEPLOYER_PRIVATE_KEY=0xyour-one-time-deployer-private-key

# --- Phase 14: LI.FI live quote adapter (lib/blockchain/lifi-execution-adapter.ts) ---
# Both optional for THIS path. LIFI_INTEGRATOR defaults to "bag-protocol" if
# unset. LIFI_API_KEY is optional for /v1/quote (higher rate limits with a
# key — register at https://portal.li.fi/). Server-only — never prefix with
# NEXT_PUBLIC_, never referenced from client code.
#
# BUT: lib/blockchain/lifi-composer-adapter.ts (single-signature same-chain
# multi-asset purchase, see V13_DURUM_RAPORU.md section K) REQUIRES this key
# — verified against the installed @lifi/composer-sdk package itself, not
# assumed: createComposeSdk() throws "apiKey is required" if this is unset
# or blank. If the Composer path is wired into the purchase flow, this stops
# being optional the moment that code path is reachable.
LIFI_INTEGRATOR=bag-protocol
LIFI_API_KEY=

# --- Phase 17: real wallet + LI.FI execution (browser-side) ---
# Optional. Client-side integrator name shown to LI.FI/wallets during
# execution — separate from LIFI_INTEGRATOR above because this one is
# bundled into the browser (NEXT_PUBLIC_*), never LIFI_API_KEY (that stays
# server-only, see lib/blockchain/lifi-config.ts).
NEXT_PUBLIC_LIFI_INTEGRATOR=bag-protocol

# Optional. Public WalletConnect (Reown) project id from cloud.reown.com —
# adds "WalletConnect" (QR code for phone wallets) to the wallet picker.
# Not a secret: it is bundled into the browser. Empty = option hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Crypto prices (docs/PRICE_AND_DATA_LAYER.md) ---
# Crypto assets on every chain are priced from LI.FI's token priceUSD through
# the same LI.FI client as quotes (LIFI_API_KEY above raises its rate limits).
# A fallback is used ONLY when LI.FI has no price for a token (data gap), never
# during a LI.FI outage:
#   Robinhood Chain → Uniswap v3 TWAP (ROBINHOOD_PRICE_POOLS below)
#   other chains    → CoinGecko, only if CRYPTO_PRICE_FALLBACK=coingecko
# Robinhood Stock Tokens always use Robinhood's keyless Stock Token API
# (no configuration or key exists or is needed for it).
CRYPTO_PRICE_FALLBACK=
COINGECKO_API_KEY=

# Test/local-only escape hatch — NEVER set this in a deployed environment.
# lib/server/price-provider.ts throws at startup if this is "mock" AND
# NODE_ENV=production, so a misconfigured deploy fails loudly instead of
# quietly pricing real purchases off MockPriceProvider.
PRICE_PROVIDER=

# --- Creator Rewards Vault (contracts/CreatorRewardsVault.sol, contracts/RedeemFeeRouter.sol) ---
# Production settlement chain is Robinhood Chain ONLY (chain id 4663) — see
# lib/config/robinhood-chain.ts, which is the single source of truth for
# the chain id / RPC / reward token address and refuses to be overridden
# per-network the way the multi-chain BagFactory config above is. Do not
# add a second reward token or a second settlement chain here.

# Server-only, ONE-TIME USE. The wallet that broadcasts
# scripts/deploy-creator-rewards.ts's deployment transactions. Does not need
# to be, and should not remain, a privileged role afterwards — the deployed
# contracts' `owner`/settler roles are configured separately (see below) and
# do not have to match the deploying key.
CREATOR_REWARDS_DEPLOYER_PRIVATE_KEY=0xyour-one-time-deployer-private-key

# Server-only. Deploy-time owner of CreatorRewardsVault / RedeemFeeRouter.
# MUST be a multisig in production, never a hot EOA — see contract NatSpec.
CREATOR_REWARDS_OWNER_ADDRESS=0xyour-multisig-address

# The settlement worker's wallet (lib/server/creator-rewards-settlement.ts).
# Added as a vault settler via CreatorRewardsVault.setSettler at deploy time.
# Must hold an ERC-20 approval on the reward token to the vault for at least
# as much as it will ever settle in one batch. Holds no special withdrawal
# right of its own — see contract NatSpec.
CREATOR_REWARDS_SETTLEMENT_WALLET_ADDRESS=0xyour-settlement-worker-address
# Server-only — the above wallet's private key, used by the settlement
# worker process itself (not by the deploy script).
CREATOR_REWARDS_SETTLEMENT_PRIVATE_KEY=0xyour-settlement-worker-private-key

# The address that signs EIP-712 fee attestations for RedeemFeeRouter —
# proves a given (redemptionId, feeAmount, creator) triple was actually
# computed by our backend from real cost-basis data, not supplied by a
# possibly-malicious frontend. Configured on RedeemFeeRouter at deploy time.
REDEEM_FEE_ATTESTOR_ADDRESS=0xyour-fee-attestor-address
# Server-only — the above address's private key, used by the API route that
# signs attestations (not by the deploy script). Rotate both together via
# RedeemFeeRouter.setFeeAttestor if ever suspected compromised.
REDEEM_FEE_ATTESTOR_PRIVATE_KEY=0xyour-fee-attestor-private-key

# Filled in only after real deployment (see scripts/deploy-creator-rewards.ts).
# lib/config/robinhood-chain.ts's DEPLOYED_CONTRACTS reads these at runtime;
# leaving them unset makes any code path that needs them fail closed rather
# than silently using a placeholder/guessed address.
CREATOR_REWARDS_VAULT_ADDRESS=
REDEEM_FEE_ROUTER_ADDRESS=

# Bag deployment on Robinhood Chain (see the "Bag deployment (user-signed)" block
# above). The RPC comes from the Blockchain RPC block (Alchemy / ROBINHOOD_RPC_URL,
# public https://rpc.mainnet.chain.robinhood.com as the last resort).
# FACTORY_ADDRESS_ROBINHOOD has NO fallback and is REQUIRED to deploy Bags on this
# chain — leaving it unset fails closed (CHAIN_UNAVAILABLE), it never falls back to
# a mock. Filled in only after scripts/deploy-bag-factory.ts robinhood has run.
FACTORY_ADDRESS_ROBINHOOD=
CONFIRMATIONS_ROBINHOOD=1

# Client-side (browser) copy of the vault address, read by
# hooks/useCreatorRewards.ts / lib/blockchain/creator-rewards-vault-client.ts
# to show a creator's live claimable balance and let them call `withdrawAll`
# directly from their own wallet. Safe to expose publicly — it's a contract
# address, not a secret. Leave unset to hide the on-chain claim UI entirely
# (falls back to the existing Supabase-ledger-only display).
NEXT_PUBLIC_CREATOR_REWARDS_VAULT_ADDRESS=

# NOT YET SET ANYWHERE — see lib/config/robinhood-chain.ts's module doc.
# No canonical Uniswap deployment address for Robinhood Chain has been
# independently verified from Uniswap's own deployment registry. Required
# before scripts/deploy-creator-rewards.ts can allowlist a real swap target
# on RedeemFeeRouter.
ROBINHOOD_UNISWAP_SWAP_TARGET_ADDRESS=

# --- Robinhood Stock Tokens (lib/domain/basket-protocol/pricing/bag-price-router.ts) ---
# See docs/ROBINHOOD_PRICE_AUTHORITY.md. No key is needed for Robinhood's API.
#   Stock Tokens (listed ACTIVE on chain 4663 in api.robinhood.com/rhj/assets):
#     price = /rhj/prices mid x currentMultiplier; when a Chainlink feed is
#     configured it VERIFIES that price on-chain (disagreement fails closed)
#   Other Robinhood assets (USDG, WETH, ...) are crypto: LI.FI, TWAP on a data gap
# Check live with: npx tsx scripts/verify-robinhood-stock-api.ts AAPL CRWD
#
# Optional. Chainlink feed per Stock Token, copied from docs.chain.link
# (Robinhood tokenized equities). The answer is already multiplier-adjusted.
# JSON: {"0xtoken":"0xfeed", ...}. A feed for an address that is not in the
# registry is refused.
ROBINHOOD_CHAINLINK_FEEDS=
# Optional. Max age of a Chainlink round in seconds (default 300). Equity feeds
# may not update while markets are closed; raising this trades freshness for
# availability.
ROBINHOOD_CHAINLINK_MAX_AGE_SECONDS=
# Optional. Max Robinhood API vs Chainlink disagreement in bps (default 200).
ROBINHOOD_PRICE_MAX_DEVIATION_BPS=
# Optional. Max age (default 300) and max bid/ask spread in bps (default 500)
# of a /rhj/prices quote used as a price.
ROBINHOOD_API_MAX_AGE_SECONDS=
ROBINHOOD_API_MAX_SPREAD_BPS=
#
# Fallback for non-stock Robinhood assets when LI.FI has no price: explicitly
# configured Uniswap v3 pools vs USDG, verified on-chain (factory, token pair,
# factory.getPool) before use. Pools configured for Stock Tokens are ignored
# (a DEX pool is not a Stock Token's reference price).
# JSON: {"0xasset":"0xpool", ...}. Check with: npx tsx scripts/verify-robinhood-price.ts
ROBINHOOD_PRICE_POOLS=
# Optional. TWAP window in seconds (default 1800, minimum 60). The pool must
# have enough observation cardinality to cover it, or pricing fails closed.
ROBINHOOD_TWAP_WINDOW_SECONDS=

# --- Execution compiler feature flag (lib/config/execution.ts) ---
# Server-only. Exactly the string "true" turns it ON; unset/anything else is OFF.
# Read per request (not cached), so a redeploy/env change takes effect immediately.
#
#   OFF (default) — LEGACY execution path: createPurchaseIntentForUser()
#       quotes SWAP steps directly via buildPurchaseIntentSteps() (LI.FI
#       Composer when LIFI_API_KEY is set and the basket is eligible, else
#       per-leg LI.FI). BagRouterProvider is NEVER used, POST
#       /api/bags/[id]/purchase-options and a client-chosen provider both
#       answer PROVIDER_SELECTION_UNAVAILABLE.
#   ON  — PROVIDER COMPILER path: steps go through compileBagExecution()
#       (lib/execution/) over the ordered registry
#       BAG Router → LI.FI Composer → LI.FI sequential, the executionPlanHash
#       is persisted and re-verified at execute time, and /purchase-options
#       (candidate comparison + provider selection) is enabled.
#
# BAG Router is registered for a purchase ONLY when ALL of these hold
# (otherwise it is simply absent and the next provider is used — never a
# half-configured provider):
#   1. BAG_EXECUTION_COMPILER_ENABLED=true
#   2. BAG_EXECUTION_ROUTER_ADDRESS and BAG_ROUTER_PLAN_SIGNER_KEY are both set (below)
#   3. the Bag's chain is `robinhood` AND it has a CONFIRMED on-chain deployment
#      (bag_deployments.on_chain_bag_id — see docs/USER_SIGNED_DEPLOYMENT.md)
# and then BagRouterProvider.supports() additionally requires every leg to be
# on Robinhood Chain (4663), same-chain, and spending the single input token.
BAG_EXECUTION_COMPILER_ENABLED=false

# --- Phase 19.X: BagExecutionRouter / RobinhoodUniswapProvider (purchase path) ---
# Both optional, together — same "no key, never attempted" rule as
# LIFI_API_KEY above. Unset (either one) means `BagRouterProvider` is never
# registered in lib/execution/registry.ts and purchase-execution.ts falls
# straight through to LI.FI Composer / sequential exactly as before this
# phase existed. Do NOT set only one of the two — a router address with no
# signer (or vice versa) leaves the provider half-configured; the code
# checks for both together (lib/server/purchase-execution.ts's
# buildBagRouterProviderConfig()) and just omits the provider if either is
# missing, so this is a "won't crash, just won't route through BAG's own
# router" state, not a hard failure — but it means a deploy is silently NOT
# using the router you may think it is.

# Server-only. `contracts/BagExecutionRouter.sol`'s deployed address on
# Robinhood Chain (chainId 4663 — see lib/config/robinhood-chain.ts).
# BEFORE setting this: the deployed router's owner MUST have already called
# setTargetAllowlist(UNISWAP_ROUTER_ADDRESS, true) and setTokenAllowlist(...)
# for every canonical asset this Bag protocol trades — the router accepts
# NOTHING by default. This env var does not deploy or configure anything;
# it only tells this app where an ALREADY-deployed, ALREADY-allowlisted
# router lives.
BAG_EXECUTION_ROUTER_ADDRESS=

# Server-only. Private key for the wallet configured as the deployed
# router's `planSigner` (see BagExecutionRouter.sol's constructor / the
# owner-only `setPlanSigner`). This key signs the EIP-712 `ExecutionPlan`
# struct server-side (lib/blockchain/bag-execution-router-signer.ts) — it
# never reaches the browser and is not the same key as any user's wallet.
# A mismatch between this key's address and the router's on-chain
# `planSigner` fails closed on-chain (InvalidPlanSignature), never silently.
# Rotate both together via setPlanSigner if ever suspected compromised.
BAG_ROUTER_PLAN_SIGNER_KEY=0xyour-plan-signer-private-key

