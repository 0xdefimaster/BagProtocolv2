# BAG SDK starter — configuration template. Contains NO secrets. Copy to `.env` (git-ignored) or, better,
# set these in your shell / secret manager. Never commit real values, never paste them into issues or chats.
# The quickstart (`npm run quickstart`) and the offline demo (`npm run demo`) need NONE of these.

# --- Live prepare / sign / verify only -------------------------------------------------------------
# Your own JSON-RPC endpoint for the strategy's chain. Treat a URL with an embedded key as a secret.
RPC_URL=
# LI.FI API key (server-side only; never ship it to a browser). See README → "LI.FI API key".
LIFI_API_KEY=
# Optional. Defaults to https://composer.li.quest
COMPOSER_URL=

# Composer deployment pin for the chain — REQUIRED, deliberately no default. Copy only from a pin you
# have reviewed yourself. Robinhood Chain (4663): docs/SDK_DEPLOYMENT_PIN_ROBINHOOD.md in the BAG repo.
# Other chains have no reviewed pin yet (README → chain support).
COMPOSER_FACTORY=
COMPOSER_FACTORY_CODE_HASH=

# Optional provenance check: set BOTH or neither. Robinhood Chain only (no registry elsewhere).
STRATEGY_REGISTRY=
EXPECTED_CREATOR=

# Local signing page (`npm run sign`) only.
INPUT_TOKEN=
# QUOTE_MAX_AGE_MS=60000
# SDK 0.4 candidate: 1 = the purchase logs each output's measured delivery (verify with DELIVERY_LOG on any RPC).
# DELIVERY_PROOF=1
# SINGLE_TRANSACTION_BLOCK | GETH_TRANSACTION_INDEX | ROBINHOOD_NITRO_TRANSACTION_INDEX | DELIVERY_LOG
# RECEIPT_EVIDENCE_MODE=
