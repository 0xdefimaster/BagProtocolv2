{
  "name": "@bagprotocol/sdk",
  "version": "0.3.0",
  "description": "bag.json v1: parse, validate, normalize, hash and verify BAG strategies, and compile unsigned purchases, without the BAG app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/adapters/http.d.ts",
      "import": "./dist/adapters/http.js"
    },
    "./evm": {
      "types": "./dist/adapters/evm.d.ts",
      "import": "./dist/adapters/evm.js"
    },
    "./lifi": {
      "types": "./dist/adapters/lifi.d.ts",
      "import": "./dist/adapters/lifi.js"
    },
    "./uniswap-v3": {
      "types": "./dist/adapters/uniswap-v3.d.ts",
      "import": "./dist/adapters/uniswap-v3.js"
    },
    "./schema": "./schema/bag.v1.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "smoke:starter": "node scripts/starter-smoke.mjs",
    "release:check": "node scripts/release-candidate.mjs"
  },
  "peerDependencies": {
    "viem": "^2.0.0",
    "@lifi/composer-sdk": ">=0.11.0 <0.12.0"
  },
  "peerDependenciesMeta": {
    "@lifi/composer-sdk": {
      "optional": true
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdefimaster/BagProtocolv2.git",
    "directory": "packages/bag-sdk"
  },
  "bugs": {
    "url": "https://github.com/0xdefimaster/BagProtocolv2/issues"
  },
  "homepage": "https://github.com/0xdefimaster/BagProtocolv2/tree/main/packages/bag-sdk"
}
