{
  "name": "@bagprotocol/sdk",
  "version": "0.2.1",
  "description": "bag.json v1: parse, validate, normalize, hash and verify BAG strategies, and compile unsigned purchases, without the BAG app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/adapters/http.d.ts",
      "import": "./dist/adapters/http.js"
    },
    "./evm": {
      "types": "./dist/adapters/evm.d.ts",
      "import": "./dist/adapters/evm.js"
    },
    "./lifi": {
      "types": "./dist/adapters/lifi.d.ts",
      "import": "./dist/adapters/lifi.js"
    },
    "./schema": "./schema/bag.v1.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke:consumer": "node scripts/consumer-smoke.mjs"
  },
  "peerDependencies": {
    "viem": "^2.0.0",
    "@lifi/composer-sdk": ">=0.11.0 <0.12.0"
  },
  "peerDependenciesMeta": {
    "@lifi/composer-sdk": {
      "optional": true
    }
  },
  "license": "MIT"
}
