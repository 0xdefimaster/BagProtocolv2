{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bagprotocol.com/schemas/bag.v1.json",
  "title": "bag.json v1",
  "description": "Public structural and per-field schema for bag.json v1. Only bagJson and definition are required; metadata and BAG-served identity/network/commitment fields are optional. JSON Schema cannot check cross-field rules such as the weight sum, chain consistency, version continuity, metadata asset membership, or recompute definitionHash. Use parseBag on the original text for duplicate-key and lexical-number checks, then validateBag for normative semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bagJson", "definition"],
  "properties": {
    "bagJson": { "const": 1 },
    "definition": { "$ref": "#/definitions/definition" },
    "definitionHash": { "$ref": "#/definitions/bytes32" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategyId", "version", "parentVersion", "createdAt"],
      "properties": {
        "strategyId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "parentVersion": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
        "createdAt": { "type": "string" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId"],
      "properties": {
        "chainId": {
          "type": ["integer", "null"],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "EIP-155 chain id as recorded by the serving application. validateBag checks it against definition.chain."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "description", "assets"],
      "properties": {
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "description": { "type": "string" },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/definitions/assetDisplay" }
        }
      },
      "description": "Display metadata only. It is outside definitionHash and never authoritative."
    },
    "commitments": {
      "type": "object",
      "description": "Opaque, non-authoritative serving metadata. The SDK never trusts this object as proof of an on-chain commitment; use verifyRegistryCommitment with an independently expected creator."
    },
    "forkedFrom": { "$ref": "#/definitions/forkedFromOrNull" }
  },
  "definitions": {
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "chain": {
      "type": "string",
      "enum": ["ethereum", "base", "arbitrum", "robinhood"]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "address", "decimals", "weightBps"],
      "properties": {
        "chain": { "$ref": "#/definitions/chain" },
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 18 },
        "weightBps": { "type": "integer", "minimum": 1, "maximum": 10000 }
      },
      "description": "Asset identity is chain + address. Display symbols live in metadata.assets, outside the hash."
    },
    "assetDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "address", "symbol"],
      "properties": {
        "chain": { "$ref": "#/definitions/chain" },
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "symbol": { "type": "string" }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "chain", "mutability", "assets", "rules"],
      "properties": {
        "kind": { "enum": ["STATIC_BASKET", null] },
        "chain": { "$ref": "#/definitions/chain" },
        "mutability": { "enum": ["MUTABLE", "IMMUTABLE", null] },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/definitions/asset" },
          "description": "A single-chain strategy. Each asset chain must equal definition.chain; validateBag checks that relation and exact sum of 10000 weightBps."
        },
        "rules": { "$ref": "#/definitions/rules" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weightBounds", "maxAssets", "minInvestment", "swapSlippageBps", "rebalance", "performanceFeeBps", "noRouteAssetPolicy"],
      "properties": {
        "weightBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minBps", "maxBps"],
          "properties": {
            "minBps": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
            "maxBps": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 }
          }
        },
        "maxAssets": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "minInvestment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["amount", "measuredAs"],
              "properties": {
                "amount": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$" },
                "measuredAs": { "const": "PAYMENT_TOKEN_AMOUNT" }
              }
            },
            { "type": "null" }
          ]
        },
        "swapSlippageBps": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 },
        "rebalance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["frequency", "driftThresholdBps"],
              "properties": {
                "frequency": { "enum": ["MANUAL", "DAILY", "WEEKLY", "MONTHLY", "THRESHOLD_ONLY", null] },
                "driftThresholdBps": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 }
              }
            },
            { "type": "null" }
          ]
        },
        "performanceFeeBps": { "type": ["integer", "null"], "minimum": 0, "maximum": 3000 },
        "noRouteAssetPolicy": { "enum": ["BLOCK", "HOLD_INPUT", "REFUND", null] }
      }
    },
    "forkedFromOrNull": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategyId", "version"],
          "properties": {
            "strategyId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "version": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        { "type": "null" }
      ]
    }
  }
}